# ===========================================================================
# Agentic AI RAG Chatbot — Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure your keys:
#   cp .env.example .env

# --- LLM Provider ---
# Options: "groq" (default, free tier) or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: OpenAI Configuration (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Vector Store ---
# Options: "chroma" (default, zero-setup local persistent DB) or "pinecone" (cloud)
VECTOR_STORE=chroma

# Optional: Pinecone Configuration (only required if VECTOR_STORE=pinecone)
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_NAME=agentic-ai-rag

# --- Embeddings ---
# Options: "sentence-transformers" (default, local/free) or "openai"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Server Settings ---
API_HOST=0.0.0.0
API_PORT=8000
